FALKORDB_HOST=localhost
FALKORDB_PORT=6381
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=8080

# OpenAI takes priority when its key is set, unless AI_PROVIDER is specified.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# AI uses the selected provider key. Set false to disable it for all users.
AI_ENABLED=true

# Local bind address; Docker sets 0.0.0.0 inside its private network.
WORKWEAVE_HOST=127.0.0.1
